{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",

    "jsx": "react-jsx",               // ✅ allow JSX in .tsx
    "allowJs": true,                  // ✅ you have JS + TS mixed
    "checkJs": false,

    "strict": true,
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "baseUrl": "src"                  // optional, nice for absolute imports
  },
  "include": ["src"]
}